<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="KapitalRS Pages" configfailurepolicy="continue">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>

    <test name="Test cases - Pro dark sr - KapitalRS - FSC regulation">
        <parameter name="regulation" value="fsc"/>
        <parameter name="countryCode" value="381"/>
        <parameter name="tag" value="?regulation=fsc&amp;regtest=true"/>
        <classes>
            <class name="tests.TestsKapitalRS.ProDarkSr"/>
        </classes>
    </test>

</suite>