<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Fortrade Pages">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>
    <parameter name="env" value="local"/>
    <parameter name="browser" value="chrome"/>
    <test name="Test cases - Premium Forex CA landing page">
        <parameter name="regulation" value="iiroc"/>
        <parameter name="countryCode" value="1"/>
        <classes>
            <class name="tests.TestsFortrade.PremiumForexCA">
                <methods>
                    <include name="checkHeaderPrivacyPolicyLinkWithLeftClickTest"/>
                    <include name="checkHeaderPrivacyPolicyLinkWithRightClickTest"/>
                    <include name="checkHeaderTermsAndConditionsLinkWithLeftClickTest"/>
                    <include name="checkHeaderTermsAndConditionsLinkWithRightClickTest"/>
                    <include name="checkAlreadyHaveAnAccountLinkWithLeftClickTest"/>
                    <include name="checkAlreadyHaveAnAccountLinkWithRightClickTest"/>
                    <include name="checkContactUsLinkTest"/>
                    <include name="checkSupportLinkTest"/>
                    <include name="checkRiskWarningLinkWithLeftClickTest"/>
                    <include name="checkRiskWarningLinkWithRightClickTest"/>
                    <include name="checkFooterPrivacyPolicyLinkWithLeftClickTest"/>
                    <include name="checkFooterPrivacyPolicyLinkWithRightClickTest"/>
                    <include name="checkFcaLinkWithLeftClickTest"/>
                    <include name="checkFcaLinkWithRightClickTest"/>
                    <include name="checkIirocLinkWithLeftClickTest"/>
                    <include name="checkIirocLinkWithRightClickTest"/>
                    <include name="checkAsicLinkWithLeftClickTest"/>
                    <include name="checkAsicLinkWithRightClickTest"/>
                    <include name="checkCysecLinkWithLeftClickTest"/>
                    <include name="checkCysecLinkWithRightClickTest"/>
                    <include name="checkFscLinkWithLeftClickTest"/>
                    <include name="checkFscLinkWithRightClickTest"/>
                    <include name="checkDfsaLinkWithLeftClickTest"/>
                    <include name="checkDfsaLinkWithRightClickTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>