<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Broker Views Pages">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>
    <parameter name="env" value="local"/>
    <parameter name="browser" value="chrome"/>
    <test name="Test cases - Pro Dark EN landing page">
        <parameter name="countryCode" value="Serbia"/>
        <parameter name="regulation" value="FSC"/>
        <classes>
            <class name="tests.TestsBrokerView.ProDarkEn"/>
        </classes>
    </test>
</suite>