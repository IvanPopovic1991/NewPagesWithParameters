<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Broker Views Pages" configfailurepolicy="continue">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
        <listener class-name="core.listeners.RegulationMethodInterceptor"/>
    </listeners>

    <test name="Test cases - Br1 en Ice - Broker Views - FSC regulation">
        <parameter name="regulation" value="fsc"/>
        <parameter name="countryCode" value="389"/>
        <!--Dodat je "&amp;" u tag-u jer URL vec sadrzi "?"-->
        <parameter name="tag" value="&amp;regulation=fsc&amp;regtest=true"/>
        <classes>
            <class name="tests.TestsBrokerViews.Br1EnIce">
                <methods>
                    <include name="verifyErrorMessageForFirstNameTest"/>
                    <include name="nonValidParameterInTheUrlTest"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>