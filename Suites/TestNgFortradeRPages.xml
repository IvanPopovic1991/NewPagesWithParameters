<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FortradeR Pages">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>
    <parameter name="env" value="local"/>
    <parameter name="browser" value="chrome"/>
    <test name="Test cases - Trusted Broker ES landing page">
        <parameter name="countryCode" value="381"/>
        <classes>
            <class name="tests.TestsFortradeR.TrustedBrokerEs">
                <methods>
                    <exclude name="logoClickabilityTest"/>
                    <exclude name="customTagContainsDummy"/>
                    <exclude name="customTagContainsDummyValue"/>
                    <exclude name="checkLanguageFieldContainsExpectedValue"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>