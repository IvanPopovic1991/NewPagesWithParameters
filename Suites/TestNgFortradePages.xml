<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Fortrade Pages">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="core.listeners.RetryTransformer"/>
        <listener class-name="core.listeners.ScreenshotListener"/>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>
    <parameter name="env" value="local"/>
    <parameter name="browser" value="chrome"/>
    <test name="Test cases - Premium Forex CA landing page">
        <parameter name="regulation" value="iiroc"/>
        <parameter name="countryCode" value="1"/>
        <classes>
            <class name="tests.TestsFortrade.PremiumForexCA">
                <methods>
                    <include name="checkHeaderPrivacyPolicyLinkWithLeftClick"/>
                    <include name="checkHeaderPrivacyPolicyLinkWithRightClick"/>
                    <include name="checkHeaderTermsAndConditionsLinkWithLeftClick"/>
                    <include name="checkHeaderTermsAndConditionsLinkWithRightClick"/>
                    <include name="checkAlreadyHaveAnAccountLinkWithLeftClick"/>
                    <include name="checkAlreadyHaveAnAccountLinkWithRightClick"/>
                    <include name="checkContactUsLink"/>
                    <include name="checkSupportLink"/>
                    <include name="checkRiskWarningLinkWithLeftClick"/>
                    <include name="checkRiskWarningLinkWithRightClick"/>
                    <include name="checkFooterPrivacyPolicyLinkWithLeftClick"/>
                    <include name="checkFooterPrivacyPolicyLinkWithRightClick"/>
                    <include name="checkFcaLinkWithLeftClick"/>
                    <include name="checkFcaLinkWithRightClick"/>
                    <include name="checkIirocLinkWithLeftClick"/>
                    <include name="checkIirocLinkWithRightClick"/>
                    <include name="checkAsicLinkWithLeftClick"/>
                    <include name="checkAsicLinkWithRightClick"/>
                    <include name="checkCysecLinkWithLeftClick"/>
                    <include name="checkCysecLinkWithRightClick"/>
                    <include name="checkFscLinkWithLeftClick"/>
                    <include name="checkFscLinkWithRightClick"/>
                    <include name="checkDfsaLinkWithLeftClick"/>
                    <include name="checkDfsaLinkWithRightClick"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>